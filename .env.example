# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=your_socket_io_server_url

# Environment
NODE_ENV=development

# Asistente IA (Ollama + Llama). En local: http://localhost:11434
# En produccion sera la URL del servidor Linux donde corra Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Hilos de CPU del modelo. Dejalo vacio si corre en GPU (Ollama decide mejor).
# En CPU, ponle el numero de nucleos FISICOS: pasarse lo hace mas lento.
OLLAMA_NUM_THREAD=

# Lectura de imagenes (capturas que adjunta el estudiante). Necesita un modelo
# con vision. Probado en una RTX 4050 (6 GB): moondream devuelve vacio y llava:7b
# inventa lo que "lee". Por eso va APAGADO: con 6 GB no hay opcion local decente.
# Para encenderlo hacen falta las dos variables.
OLLAMA_VISION_MODEL=
NEXT_PUBLIC_VISION_ENABLED=
